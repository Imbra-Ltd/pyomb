# The editor-side half of the line-ending rule; .gitattributes is the git-side
# guarantee. Together they keep a contributor whose editor has no EditorConfig
# plugin from being the one who commits CRLF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# 80 is the preferred width for new code; ruff permits up to 120. Both are
# drawn as rulers in .vscode/settings.json, which may also show markers that
# gate nothing -- a ruler is a guide, not a limit.
[*.py]
indent_size = 4
max_line_length = 80

[*.{yml,yaml,json,toml}]
indent_size = 2

# Two trailing spaces are a hard line break in Markdown, so trimming them
# changes what the document renders as. The width below is where the wrap
# rule's number lives, and tests/test_markdown_line_width.py reads it from
# here rather than carrying a copy of its own. Editing this line moves the
# gate with it.
[*.md]
indent_size = 2
trim_trailing_whitespace = false
max_line_length = 80
